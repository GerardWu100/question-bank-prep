# Local listener; set a password before using a non-loopback address.
STUDY_HOST=127.0.0.1
# HTTP port, integer from 1 through 65535.
STUDY_PORT=3000
# Runtime database directory, relative to project root or absolute.
STUDY_DATA_DIR=app-data
# Optional local password; required for any non-loopback listener.
STUDY_PASSWORD=
# true behind a reverse proxy that serves HTTPS (login cookie Secure, HSTS, per-visitor login limit); forwarding headers count only from loopback or private-network proxies. Allowed: true, false.
TRUST_PROXY=false
# Optional existing Markdown folder, synced into the library each time it opens. Empty means uploaded materials only.
MATERIAL_ROOT=
# Optional read-only folder of Markdown study material shown on the Materials page (never edited or imported).
READING_ROOT=
# ChatGPT sign-in file when running natively; empty means $CODEX_HOME/auth.json, else ~/.codex/auth.json. Never paste tokens here.
CODEX_AUTH_FILE=
# Docker only: host folder holding that auth.json (mounted at /codex); default ~/.codex.
CODEX_HOME=
# Most AI model requests (Codex login or API key) the whole app may send in any 60 minutes. One tutor reply is 1 request plus 1 per tool round (at most 6). Whole number; 0 means no cap.
AI_MAX_REQUESTS_PER_HOUR=60
# Most AI model requests in any 24 hours. Whole number; 0 means no cap.
AI_MAX_REQUESTS_PER_DAY=300
