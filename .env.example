# Local listener; set a password before using a non-loopback address.
STUDY_HOST=127.0.0.1
# HTTP port, integer from 1 through 65535.
STUDY_PORT=3000
# Runtime database directory, relative to project root or absolute.
STUDY_DATA_DIR=app-data
# Optional local password; required for any non-loopback listener.
STUDY_PASSWORD=
# Optional existing Markdown folder, synced into the library each time it opens. Empty means uploaded materials only.
MATERIAL_ROOT=
# Optional read-only folder of Markdown study material shown on the Materials page (never edited or imported).
READING_ROOT=
# Existing Codex credential directory; default is ~/.codex. Never paste tokens here.
CODEX_HOME=
