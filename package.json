{
  "name": "question-bank-prep",
  "version": "1.0.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "tsx apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts && node scripts/compress-build.mjs",
    "start": "tsx apps/server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-browser-tests.mjs",
    "backup": "tsx scripts/backup.ts",
    "check-bank": "tsx scripts/check-bank.ts",
    "find-duplicates": "tsx scripts/find-duplicates.ts",
    "build:desktop": "node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "highlight.js": "11.12.0",
    "katex": "0.16.47",
    "mermaid": "12.1.0",
    "proper-lockfile": "4.1.2",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
